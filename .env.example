# URL pública da ferramenta (formulário/resultado/admin), para onde os
# CTAs desta LP apontam. Defina o valor real em produção (Vercel →
# Project Settings → Environment Variables).
NEXT_PUBLIC_TOOL_URL=https://ferramenta.nucleointernacional.example.com

# Número de WhatsApp de destino dos CTAs — só dígitos, com DDI.
# Ex.: 55 (Brasil) + 47 (DDD) + 9XXXXXXXX.
NEXT_PUBLIC_WHATSAPP=5547999998888

# Opcional. Sem esta variável, o formulário de inscrição só valida e
# encaminha para o WhatsApp. Com ela, cada inscrição também é gravada
# numa tabela isolada `lp_inscricoes` (mesmo Postgres/Neon da ferramenta;
# a tabela é criada sozinha na primeira inscrição).
DATABASE_URL=
